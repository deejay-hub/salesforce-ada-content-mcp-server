{
  "name": "salesforce-content-mcp-server",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "dev": "tsx src/server/index.ts",
    "ingest:latest": "tsx scripts/ingest-latest.ts --out /tmp/new-chunks.csv && python3 scripts/merge-seed.py /tmp/new-chunks.csv",
    "refresh": "bash scripts/refresh-content.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cheerio": "^1.0.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.1.0",
    "fastembed": "^1.14.0",
    "pg": "^8.13.0",
    "pgvector": "^0.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
